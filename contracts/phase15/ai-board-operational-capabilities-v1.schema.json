{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/mrmic/contracts/phase15/ai-board-operational-capabilities-v1.schema.json",
  "title": "MRMIC AI Board Operational Adapter Capabilities v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "provider",
    "resourceKind",
    "sharedRuntimeVersion",
    "supportedEffects",
    "authorityBoundIdentity",
    "callerSuppliedProviderIdentity",
    "appendTarget",
    "receiptIncludesContent",
    "providerNativeIdempotency",
    "ambiguousOutcomePolicy",
    "ambiguousOutcomeScope",
    "maxAmbiguousOutcomes"
  ],
  "properties": {
    "schema": { "const": "ai_board_operational_capabilities_v1" },
    "provider": { "const": "ai_board" },
    "resourceKind": { "const": "ai_board_thread" },
    "sharedRuntimeVersion": { "const": "provider_operational_runtime_v1" },
    "supportedEffects": { "type": "array", "const": ["message.append"] },
    "authorityBoundIdentity": { "const": true },
    "callerSuppliedProviderIdentity": { "const": false },
    "appendTarget": { "const": "existing_thread_root" },
    "receiptIncludesContent": { "const": false },
    "providerNativeIdempotency": { "const": false },
    "ambiguousOutcomePolicy": { "const": "refuse_same_command_replay" },
    "ambiguousOutcomeScope": { "const": "runtime_instance" },
    "maxAmbiguousOutcomes": { "const": 256 }
  }
}
