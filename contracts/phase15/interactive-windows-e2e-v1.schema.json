{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/mrmic/contracts/phase15/interactive-windows-e2e-v1.schema.json",
  "title": "MRMIC Interactive Windows E2E Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "passed", "startedAt", "completedAt", "interactiveSessionConfirmedByCaller",
    "target", "portal", "capture", "lifecycle", "canonical"
  ],
  "properties": {
    "schema": { "const": "interactive_windows_e2e_v1" },
    "passed": { "const": true },
    "startedAt": { "type": "string", "minLength": 1, "maxLength": 128 },
    "completedAt": { "type": "string", "minLength": 1, "maxLength": 128 },
    "interactiveSessionConfirmedByCaller": { "const": true },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "providerEpoch", "providerResourceId", "hwndHex", "processId", "title"],
      "properties": {
        "provider": { "const": "windows" },
        "providerEpoch": { "type": "string", "minLength": 1, "maxLength": 128 },
        "providerResourceId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "hwndHex": { "type": "string", "pattern": "^0x[0-9a-f]+$" },
        "processId": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    },
    "portal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["portalId", "portalObjectId", "canvasId", "viewId"],
      "properties": {
        "portalId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "portalObjectId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "canvasId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "viewId": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["samplesRequested", "samples", "distinctFrameSequences", "monotonicNonDecreasing"],
      "properties": {
        "samplesRequested": { "type": "integer", "minimum": 1, "maximum": 20 },
        "samples": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["frameSequence", "sha256", "encodedBytes", "width", "height", "svgContainsProjectedImage"],
            "properties": {
              "frameSequence": { "type": "integer", "minimum": 1 },
              "capturedAt": { "type": "string", "minLength": 1, "maxLength": 128 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "encodedBytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
              "width": { "type": "integer", "minimum": 1, "maximum": 32768 },
              "height": { "type": "integer", "minimum": 1, "maximum": 32768 },
              "svgContainsProjectedImage": { "const": true }
            }
          }
        },
        "distinctFrameSequences": { "type": "integer", "minimum": 1, "maximum": 20 },
        "monotonicNonDecreasing": { "const": true }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frozenRetainedFrame", "frozenProviderRead", "sleepingClearedPixels", "sleepingProviderRead"],
      "properties": {
        "frozenRetainedFrame": { "const": true },
        "frozenProviderRead": { "const": false },
        "sleepingClearedPixels": { "const": true },
        "sleepingProviderRead": { "const": false }
      }
    },
    "canonical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerPreviewUriRetained", "dataUriPersisted"],
      "properties": {
        "providerPreviewUriRetained": { "const": true },
        "dataUriPersisted": { "const": false }
      }
    }
  },
  "$comment": "Evidence intentionally excludes bytesBase64, data URIs and other captured pixel payloads."
}
