{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/mrmic/contracts/phase15/live-portal-visual-frame-v1.schema.json",
  "title": "MRMIC Live Portal Visual Frame v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "portalObjectId",
    "provider",
    "providerResourceId",
    "frameSequence",
    "capturedAt",
    "width",
    "height",
    "mimeType",
    "sha256",
    "bytesBase64",
    "transport"
  ],
  "properties": {
    "schema": { "const": "live_portal_visual_frame_v1" },
    "portalObjectId": { "type": "string", "minLength": 1, "maxLength": 512 },
    "provider": { "type": "string", "minLength": 1, "maxLength": 128 },
    "providerResourceId": { "type": "string", "minLength": 1, "maxLength": 512 },
    "frameSequence": { "type": "integer", "minimum": 1 },
    "capturedAt": { "type": "string", "minLength": 1, "maxLength": 128 },
    "width": { "type": "integer", "minimum": 1, "maximum": 32768 },
    "height": { "type": "integer", "minimum": 1, "maximum": 32768 },
    "mimeType": { "const": "image/png" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "bytesBase64": { "type": "string", "minLength": 4, "maxLength": 22369640 },
    "transport": { "type": "string", "minLength": 1, "maxLength": 128 }
  }
}
