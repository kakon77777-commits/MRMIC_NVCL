{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/mrmic/contracts/phase15/mrmic-operational-command-v1.schema.json",
  "title": "MRMIC Provider-Neutral Operational Command v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "commandId",
    "idempotencyKey",
    "provider",
    "effectKind",
    "principalId",
    "resourceRef",
    "payload"
  ],
  "properties": {
    "schema": { "const": "mrmic_operational_command_v1" },
    "commandId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 256 },
    "provider": { "type": "string", "minLength": 1, "maxLength": 128 },
    "effectKind": { "type": "string", "minLength": 1, "maxLength": 128 },
    "principalId": { "type": "string", "minLength": 1, "maxLength": 512 },
    "resourceRef": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16
    },
    "payload": {
      "type": "object",
      "maxProperties": 64
    }
  }
}
