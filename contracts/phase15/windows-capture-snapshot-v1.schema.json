{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/mrmic/contracts/phase15/windows-capture-snapshot-v1.schema.json",
  "title": "MRMIC Windows Capture Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "mountId",
    "providerResourceId",
    "frameSequence",
    "capturedAt",
    "width",
    "height",
    "mimeType",
    "encodedBytes",
    "sha256",
    "bytesBase64",
    "transport"
  ],
  "properties": {
    "schema": { "const": "windows_capture_snapshot_v1" },
    "mountId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "providerResourceId": { "type": "string", "minLength": 1, "maxLength": 512 },
    "frameSequence": { "type": "integer", "minimum": 1 },
    "capturedAt": { "type": "string", "minLength": 1, "maxLength": 128 },
    "width": { "type": "integer", "minimum": 1, "maximum": 32768 },
    "height": { "type": "integer", "minimum": 1, "maximum": 32768 },
    "mimeType": { "const": "image/png" },
    "encodedBytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "bytesBase64": { "type": "string", "minLength": 4, "maxLength": 22369640 },
    "transport": { "const": "png_base64_snapshot_v1" }
  },
  "allOf": [
    {
      "if": { "required": ["width", "height"] },
      "then": {
        "$comment": "Readers must additionally enforce width * height <= 8294400; JSON Schema draft 2020-12 cannot portably express multiplication."
      }
    }
  ]
}
