{
  "name": "mrmic-nvcl-mvp",
  "version": "0.13.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.5.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "demo": "npm run build && node --no-warnings dist/apps/cli/src/index.js",
    "migrate": "npm run build && node --no-warnings dist/apps/cli/src/migrate.js",
    "web": "npm run build && node --no-warnings dist/apps/web/src/server.js",
    "phase1:demo": "npm run build && node --no-warnings dist/apps/phase1-demo/src/index.js",
    "phase2:demo": "npm run build && node --no-warnings dist/apps/phase2-demo/src/index.js",
    "sync": "npm run build && node --no-warnings dist/apps/web/src/server.js",
    "phase3:demo": "npm run build && node --no-warnings dist/apps/phase3-demo/src/index.js",
    "mcp": "npm run web",
    "phase4:demo": "npm run build && node --no-warnings dist/apps/phase4-demo/src/index.js",
    "phase5:demo": "npm run build && node --no-warnings dist/apps/phase5-demo/src/index.js",
    "nvcl": "npm run phase4:demo",
    "recursive": "npm run phase5:demo",
    "phase6:demo": "npm run build && node --no-warnings dist/apps/phase6-demo/src/index.js",
    "hardening": "npm run phase6:demo",
    "lab": "npm run web",
    "phase7:lab": "npm run web",
    "phase8:demo": "npm run build && node --no-warnings dist/apps/phase8-demo/src/index.js",
    "phase8:codex": "npm run build && node --no-warnings dist/apps/phase8-demo/src/codex.js",
    "phase9:demo": "npm run build && node --no-warnings dist/apps/phase9-demo/src/index.js",
    "phase10:demo": "npm run build && node --no-warnings dist/apps/phase10-demo/src/index.js",
    "phase11:demo": "npm run build && node --no-warnings dist/apps/phase11-demo/src/index.js",
    "phase12:demo": "npm run build && node --no-warnings dist/apps/phase12-demo/src/index.js",
    "phase12:probe": "npm run build && node --no-warnings dist/apps/phase12-demo/src/codex-ab.js --probe-only",
    "phase12:codex-ab": "npm run build && node --no-warnings dist/apps/phase12-demo/src/codex-ab.js",
    "release:manifest": "node scripts/release-manifest.mjs",
    "release:verify": "node scripts/verify-release.mjs"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2"
  }
}
